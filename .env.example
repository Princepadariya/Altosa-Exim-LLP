# Inquiry form delivery — read by api/inquiry.js on the server, never by the browser.
#
# Copy to .env.local for local work with `vercel dev` (.env.local is gitignored
# by the *.local rule). For the deployed site set the same values in the Vercel
# dashboard under Settings > Environment Variables. Never commit real values.

# --- SMTP -------------------------------------------------------------------
# Gmail / Google Workspace : smtp.gmail.com          port 465
# Zoho (India)             : smtp.zoho.in            port 465
# Microsoft 365            : smtp.office365.com      port 587
# cPanel / shared hosting  : mail.yourdomain.com     port 465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The full mailbox address the site authenticates as.
SMTP_USER=rfq@altosaexim.com

# An APP PASSWORD, not the account's login password. Generated in the mail
# provider's security settings; for Google it requires 2-step verification to
# be on first. Revoking it later does not disturb the account itself.
SMTP_PASS=xxxxxxxxxxxxxxxx

# --- Addressing -------------------------------------------------------------
# Where inquiries land. Defaults to SMTP_USER if unset.
INQUIRY_TO=exim@altosaeximllp.com

# Display sender. Most providers refuse to send as an address the session did
# not authenticate as, so keep the address here equal to SMTP_USER and vary
# only the name. Defaults to SMTP_USER if unset.
INQUIRY_FROM=Altosa Exim <rfq@altosaexim.com>
